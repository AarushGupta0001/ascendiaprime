  display: grid;
  grid-template-columns: 26px 1fr;
  gap: 7px;
  border: 1px solid rgba(126,149,205,.15);
  border-radius: 10px;
  background: rgba(5,11,28,.72);
  opacity: .4;
  transform: translateY(4px);
  animation: ppc-creative-in .45s ease 2.25s forwards;
}

.ppc-creative-option > span {
  width: 25px;
  height: 25px;
  display: grid;
  place-items: center;
  border-radius: 7px;
  background: rgba(138,101,255,.13);
  color: #a98cff;
  font-size: 9px;
  font-weight: 800;
}

.ppc-creative-option small,
.ppc-creative-option strong {
  display: block;
}

.ppc-creative-option small {
  color: #60708e;
  font-size: 6px;
}

.ppc-creative-option strong {
  margin-top: 3px;
  font-size: 8px;
  white-space: nowrap;
}

.ppc-creative-option div > i {
  display: block;
  width: 67px;
  height: 3px;
  margin-top: 7px;
  border-radius: 99px;
  background: #202d4b;
}

.ppc-creative-option > em {
  position: absolute;
  left: 9px;
  right: 9px;
  bottom: 8px;
  padding-top: 5px;
  border-top: 1px solid rgba(112,135,190,.11);
