@media (prefers-reduced-motion: reduce) {
  .ppc-console-replay {
    display: none;
  }

  .ppc-console-aura,
  .ppc-scan-line {
    display: none;
  }

  .ppc-platform,
  .ppc-query-field > i,
  .ppc-auction-steps > span,
  .ppc-option-a,
  .ppc-option-b,
  .ppc-verification-strip article,
