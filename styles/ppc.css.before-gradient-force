  height: 2px !important;
  background: rgba(42, 55, 91, .85) !important;
  overflow: visible !important;
}

.ppc-demand-panel .ppc-auction-fill {
  position: absolute !important;
  left: 0 !important;
  top: 0 !important;
  height: 2px !important;
  width: 0 !important;

  /* EXACT REFERENCE GRADIENT */
  background: linear-gradient(
    90deg,
    #59a8ff 0%,
    #8a65ff 50%,
    #ed4fd6 100%
  ) !important;

  border-radius: 999px !important;

  box-shadow:
    0 0 5px rgba(89, 168, 255, .75),
    0 0 10px rgba(138, 101, 255, .55),
    0 0 16px rgba(237, 79, 214, .35) !important;

  animation:
    ppc-reference-auction-fill 1.35s cubic-bezier(.4,0,.2,1) 1s forwards !important;
}

@keyframes ppc-reference-auction-fill {
  from {
    width: 0 !important;
  }

  to {
    width: 100% !important;
  }
}

/* Moving cyan signal stays centered on the gradient endpoint */
.ppc-demand-panel .ppc-auction-pulse {
  position: absolute !important;
  top: 50% !important;
  width: 10px !important;
  height: 10px !important;
  margin-top: -5px !important;
  border: 2px solid #43dfcf !important;
  border-radius: 50% !important;
  background: #081027 !important;
  box-sizing: border-box !important;
  z-index: 5 !important;

  box-shadow:
    0 0 6px rgba(67,223,207,.9),
    0 0 13px rgba(67,223,207,.55) !important;

  animation:
    ppc-reference-auction-pulse 1.35s cubic-bezier(.4,0,.2,1) 1s forwards !important;
}

@keyframes ppc-reference-auction-pulse {
  from {
    left: 0 !important;
    opacity: 1 !important;
  }

  to {
    left: calc(100% - 10px) !important;
    opacity: 1 !important;
  }
}

/* Checkpoints: perfectly circular and centered on the bar */
.ppc-demand-panel .ppc-auction-steps > span {
  position: relative !important;
}

.ppc-demand-panel .ppc-auction-steps > span::before {
  position: absolute !important;
  top: 13px !important;
  left: 50% !important;

  width: 11px !important;
  height: 11px !important;

  margin-left: -5.5px !important;
  margin-top: -5.5px !important;

  box-sizing: border-box !important;
  border: 2px solid #3b496b !important;
  border-radius: 50% !important;
  background: #091128 !important;

  transform: none !important;
}

.ppc-demand-panel .ppc-auction-steps > span::after {
  position: absolute !important;
  top: 13px !important;
  left: 50% !important;

  width: 5px !important;
  height: 5px !important;

  margin-left: -2.5px !important;
  margin-top: -2.5px !important;

  border-radius: 50% !important;
  background: #43dfcf !important;

  transform: none !important;
  z-index: 4 !important;
}

/* Exact checkpoint positions */
.ppc-demand-panel .ppc-step-one {
  text-align: left !important;
}

.ppc-demand-panel .ppc-step-two {
  text-align: center !important;
}

.ppc-demand-panel .ppc-step-three {
  text-align: right !important;
}

