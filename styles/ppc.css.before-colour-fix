  display: grid;
  grid-template-columns: 26px 1fr;
  gap: 7px;
  border: 1px solid rgba(126,149,205,.15);
  border-radius: 10px;
  background: rgba(5,11,28,.72);
  opacity: .4;
  transform: translateY(4px);
  animation: ppc-creative-in .45s ease 2.25s forwards;
}

.ppc-creative-option > span {
  width: 25px;
  height: 25px;
  display: grid;
  place-items: center;
  border-radius: 7px;
  background: rgba(138,101,255,.13);
  color: #a98cff;
  font-size: 9px;
  font-weight: 800;
}

.ppc-creative-option small,
.ppc-creative-option strong {
  display: block;
}

.ppc-creative-option small {
  color: #60708e;
  font-size: 6px;
}

.ppc-creative-option strong {
  margin-top: 3px;
  font-size: 8px;
  white-space: nowrap;
}

.ppc-creative-option div > i {
  display: block;
  width: 67px;
  height: 3px;
  margin-top: 7px;
  border-radius: 99px;
  background: #202d4b;
}

.ppc-creative-option > em {
  position: absolute;
  left: 9px;
  right: 9px;
  bottom: 8px;
  padding-top: 5px;
  border-top: 1px solid rgba(112,135,190,.11);
  color: #65728f;
  font-size: 6px;
  font-style: normal;
  text-align: right;
}

.ppc-option-b {
  animation-delay: 2.45s;
}

.ppc-option-b > span {
  background: rgba(237,79,214,.13);
  color: var(--pink);
}

.ppc-option-b div > i {
  background: linear-gradient(90deg,var(--pink),var(--purple));
  box-shadow: 0 0 8px rgba(237,79,214,.25);
  transform-origin: left;
  animation: ppc-creative-response .7s ease 2.7s both;
}

@keyframes ppc-creative-response {
  from { transform: scaleX(.16); }
  to { transform: scaleX(1); }
}

.ppc-option-b > em {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 4px;
  color: var(--cyan);
  opacity: 0;
  animation: ppc-winner-on .3s ease 3.25s forwards;
}

.ppc-option-b > em svg {
  width: 9px;
  fill: none;
  stroke: currentColor;
  stroke-width: 2.2;
}

@keyframes ppc-winner-on {
  to { opacity: 1; }
}

.ppc-option-a {
  animation:
    ppc-creative-in .45s ease 2.25s forwards,
    ppc-creative-dim .4s ease 3.3s forwards;
}

@keyframes ppc-creative-in {
  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes ppc-creative-dim {
  to { opacity: .3; }
}

.ppc-spend-console {
  right: 17px;
  top: 235px;
  width: 230px;
  height: 125px;
  padding: 8px 11px;
}

.ppc-spend-row {
  height: 20px;
  display: grid;
  grid-template-columns: 55px 1fr 28px;
  align-items: center;
  gap: 6px;
  color: #8994ae;
  font-size: 6px;
}

.ppc-spend-row > div {
  height: 4px;
  border-radius: 99px;
  background: #1a2744;
  overflow: hidden;
}

.ppc-spend-row > div i {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: #536483;
}

.ppc-spend-row em {
  font-style: normal;
  text-align: right;
  color: #667490;
}

.ppc-explore > div i {
  width: 34%;
  animation: ppc-explore-spend .8s ease 4.85s forwards;
}

.ppc-relevant > div i {
  width: 24%;
  background: var(--purple);
  animation: ppc-relevant-spend .8s ease 4.95s forwards;
}

.ppc-proven > div i {
  width: 10%;
  background: linear-gradient(90deg,var(--pink),var(--cyan));
  box-shadow: 0 0 9px rgba(67,223,207,.35);
  animation: ppc-proven-spend 1.05s ease 5s forwards;
}

.ppc-proven {
  color: #e5f4ff;
}

.ppc-spend-console p {
  margin: 5px 0 0;
  padding-top: 6px;
  border-top: 1px solid rgba(112,135,190,.11);
  color: #677590;
  font-size: 5.7px;
}

.ppc-spend-console p i {
  display: inline-block;
  width: 5px;
  height: 5px;
  margin-right: 5px;
  border-radius: 50%;
  background: var(--cyan);
  box-shadow: 0 0 8px var(--cyan);
}

@keyframes ppc-explore-spend {
  to { width: 16%; opacity: .5; }
}

@keyframes ppc-relevant-spend {
  to { width: 43%; }
}

@keyframes ppc-proven-spend {
  to { width: 92%; }
}

.ppc-verification-strip {
  position: absolute;
  left: 17px;
  right: 17px;
  top: 372px;
  height: 66px;
  padding: 10px 12px;
  display: grid;
  grid-template-columns: 1fr 34px 1fr 34px 1fr;
  align-items: center;
  border: 1px solid rgba(127,151,210,.17);
  border-radius: 13px;
  background: rgba(8,15,35,.88);
}

.ppc-verification-strip article {
  display: flex;
  align-items: center;
  gap: 8px;
  opacity: .3;
  transform: translateY(3px);
  animation: ppc-verify-on .35s ease forwards;
}

.ppc-verification-strip article > span {
  width: 25px;
  height: 25px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(67,223,207,.35);
  border-radius: 50%;
  color: var(--cyan);
}

.ppc-verification-strip svg {
  width: 13px;
  fill: none;
  stroke: currentColor;
  stroke-width: 2;
}

.ppc-verification-strip small,
.ppc-verification-strip strong {
  display: block;
}

.ppc-verification-strip small {
  color: #65738f;
  font-size: 5.5px;
  letter-spacing: .11em;
}

.ppc-verification-strip strong {
  margin-top: 4px;
  font-size: 7.5px;
  white-space: nowrap;
}

.ppc-verify-one { animation-delay: 3.6s !important; }
.ppc-verify-two { animation-delay: 4.08s !important; }
.ppc-verify-three { animation-delay: 4.56s !important; }

.ppc-verify-link {
  height: 1px;
  background: #263555;
  transform: scaleX(0);
  animation: ppc-link-on .28s ease forwards;
}

.ppc-link-one { animation-delay: 3.88s; }
.ppc-link-two { animation-delay: 4.36s; }

@keyframes ppc-verify-on {
  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes ppc-link-on {
  to {
    transform: scaleX(1);
    background: linear-gradient(90deg,var(--purple),var(--cyan));
    box-shadow: 0 0 8px rgba(67,223,207,.3);
  }
}

.ppc-final-message {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 15px;
  margin: 0;
  text-align: center;
  color: #f5f7ff;
  font-size: 11px;
  font-weight: 750;
  letter-spacing: .01em;
  opacity: .18;
  transform: translateY(4px);
  animation: ppc-final-on .55s ease 6.15s forwards;
}

.ppc-final-message span {
  color: var(--cyan);
  text-shadow: 0 0 14px rgba(67,223,207,.35);
}

@keyframes ppc-final-on {
  to {
    opacity: 1;
    transform: none;
  }
}

@media (max-width: 760px) {
  .ppc-console-wrap {
    width: 100%;
    height: 330px;
    margin-top: 30px;
  }

  .ppc-console-replay {
    right: 7px;
  }

  .ppc-decision-console {
    left: 50%;
    bottom: auto;
    top: 37px;
    transform: translateX(-50%) scale(.56);
    transform-origin: top center;
  }
}

@media (max-width: 390px) {
  .ppc-console-wrap {
    height: 295px;
  }

  .ppc-decision-console {
    transform: translateX(-50%) scale(.5);
  }
}

@media (prefers-reduced-motion: reduce) {
  .ppc-console-replay {
    display: none;
  }

  .ppc-console-aura,
  .ppc-scan-line {
    display: none;
  }

  .ppc-platform,
  .ppc-query-field > i,
  .ppc-auction-steps > span,
  .ppc-option-a,
  .ppc-option-b,
  .ppc-verification-strip article,
  .ppc-final-message {
    animation-duration: .001ms !important;
    animation-delay: 0ms !important;
    animation-iteration-count: 1 !important;
    opacity: 1;
    transform: none;
  }

  .ppc-query-field strong {
    width: 172px;
  }

  .ppc-auction-fill {
    width: 100%;
  }

  .ppc-auction-pulse {
    left: calc(100% - 10px);
    opacity: 1;
  }

  .ppc-auction-steps > span:after,
  .ppc-option-b > em {
    opacity: 1;
  }

  .ppc-option-a {
    opacity: .3;
  }

  .ppc-creative-option div > i {
    transform: none;
  }

  .ppc-verify-link {
    transform: scaleX(1);
  }

  .ppc-explore > div i {
    width: 16%;
    opacity: .5;
  }

  .ppc-relevant > div i {
    width: 43%;
  }

  .ppc-proven > div i {
    width: 92%;
  }
}
