  .ppc-option-b > em {
    opacity: 1;
  }

  .ppc-option-a {
    opacity: .3;
  }

  .ppc-creative-option div > i {
    transform: none;
  }

  .ppc-verify-link {
    transform: scaleX(1);
  }

  .ppc-explore > div i {
    width: 16%;
    opacity: .5;
  }

  .ppc-relevant > div i {
    width: 43%;
  }

  .ppc-proven > div i {
    width: 92%;
  }
