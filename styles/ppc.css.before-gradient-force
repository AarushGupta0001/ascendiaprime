/* =========================================================
   PPC AUCTION PULSE — FIX DISTORTION
   Keep the moving signal perfectly circular.
   ========================================================= */

.ppc-auction-pulse,
.auction-pulse {
  width: 10px !important;
  height: 10px !important;
  min-width: 10px !important;
  min-height: 10px !important;
  max-width: 10px !important;
  max-height: 10px !important;

  aspect-ratio: 1 / 1 !important;
  box-sizing: border-box !important;

  border-radius: 50% !important;
  transform: translateZ(0) !important;

  flex: 0 0 10px !important;

  border: 2px solid #43dfcf !important;
  background: #081027 !important;

  box-shadow:
    0 0 7px rgba(67, 223, 207, .9),
    0 0 15px rgba(67, 223, 207, .45) !important;

  will-change: left !important;
}

/* Don't scale the pulse during the animation */
@keyframes ppcAuctionPulseFixed {
  0% {
    left: 0;
    opacity: 1;
  }

  100% {
    left: calc(100% - 10px);
    opacity: 1;
  }
}

.ppc-auction-pulse,
.auction-pulse {
  animation-name: ppcAuctionPulseFixed !important;
  animation-timing-function: linear !important;
  animation-fill-mode: forwards !important;
}

/* Prevent the auction container from distorting the dot */
.ppc-auction-track,
.auction-track {
  overflow: visible !important;
}

.ppc-auction-lane,
.auction-lane {
  overflow: visible !important;
}


/* =========================================================
   PPC AUCTION — SYNC + CHECKPOINT ALIGNMENT FIX
   ========================================================= */

