/* Reset and ensure the background applies to the root */
    html, body {
        background-color: #020617 !important; /* Deep Slate 950 */
        margin: 0 !important;
        padding: 0 !important;
        overflow-x: hidden !important;
    }
    .-page, .-section-wrap, .-widget-wrap, .-widget-container, .-section {
        background-color: transparent !important;
    }

#ppc-master * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        
        /* Smooth Scroll Reveal */
        .reveal-up {
            opacity: 0; transform: translateY(40px);
            transition: opacity 0.8s ease-out, transform 0.8s ease-out;
        }
        .reveal-up.active { opacity: 1; transform: translateY(0); }

        /* Text Gradients */
        .text-gradient-brand {
            background: linear-gradient(135deg, #3F8BF9, #7469F8, #AB57F3, #E057D8);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            background-size: 300% auto; animation: textShine 6s linear infinite;
        }
        @keyframes textShine { to { background-position: 300% center; } }

        /* Home Page Gradient Pill Buttons */
        .btn-glow {
            display: inline-block;
            text-align: center;
            background: linear-gradient(to right, #3F8BF9, #7469F8, #AB57F3);
            color: #ffffff !important;
            padding: 0.875rem 2rem;
            border-radius: 16px;
            font-weight: 500;
            border: 1px solid rgba(63, 139, 249, 0.3);
            box-shadow: 0 0 20px rgba(63, 139, 249, 0.4);
            text-decoration: none !important;
            transition: all 0.3s ease;
        }
        .btn-glow:hover {
            color: #ffffff !important;
            transform: translateY(-2px);
            box-shadow: 0 0 30px rgba(63, 139, 249, 0.6);
        }
        .btn-glow-secondary {
            background: linear-gradient(to right, #7469F8, #AB57F3, #E057D8);
            border-color: rgba(171, 87, 243, 0.3);
            box-shadow: 0 0 20px rgba(171, 87, 243, 0.4);
        }
        .btn-glow-secondary:hover {
            box-shadow: 0 0 30px rgba(171, 87, 243, 0.6);
        }

        /* CLEAN TRACE CARDS (Mouse tracking removed) */
        .trace-card {
            background: var(--card-bg, rgba(30, 41, 59, 0.8));
            border-radius: 1.5rem;
            border: 1px solid var(--card-border, rgba(63, 139, 249, 0.3));
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
            backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
            overflow: hidden; 
            transition: box-shadow 0.5s ease, background 0.4s ease, border-color 0.4s ease;
            z-index: 1;
        }
        .trace-card:hover {
            background: var(--card-bg-hover, rgba(51, 65, 85, 0.95));
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
            border-color: var(--card-border-hover, rgba(116, 105, 248, 0.6));
        }
        .trace-card > * { position: relative; z-index: 2; }

        /* THEMES FOR TRACE CARDS */
        .theme-blue {
            --card-bg: rgba(30, 41, 59, 0.8);
            --card-bg-hover: rgba(51, 65, 85, 0.95);
            --card-border: rgba(63, 139, 249, 0.3);
            --card-border-hover: rgba(63, 139, 249, 0.6);
        }
        .theme-indigo {
            --card-bg: rgba(30, 41, 59, 0.8);
            --card-bg-hover: rgba(51, 65, 85, 0.95);
            --card-border: rgba(116, 105, 248, 0.3);
            --card-border-hover: rgba(116, 105, 248, 0.6);
        }
        .theme-purple {
            --card-bg: rgba(30, 41, 59, 0.8);
            --card-bg-hover: rgba(51, 65, 85, 0.95);
            --card-border: rgba(171, 87, 243, 0.3);
            --card-border-hover: rgba(171, 87, 243, 0.6);
        }
        .theme-pink {
            --card-bg: rgba(30, 41, 59, 0.8);
            --card-bg-hover: rgba(51, 65, 85, 0.95);
            --card-border: rgba(224, 87, 216, 0.3);
            --card-border-hover: rgba(224, 87, 216, 0.6);
        }

        /* Vertical Process Timeline */
        .vertical-timeline {
            position: relative;
            max-width: 1080px;
            margin: 0 auto;
            padding: 1rem 0;
        }
        .vertical-timeline::before {
            content: '';
            position: absolute;
            top: 0;
            bottom: 0;
            left: 50%;
            width: 3px;
            transform: translateX(-50%);
            background: linear-gradient(to bottom, #3F8BF9, #7469F8, #AB57F3, #E057D8);
            border-radius: 16px;
            box-shadow: 0 0 24px rgba(116, 105, 248, 0.35);
        }
        .vertical-timeline-item {
            position: relative;
            display: grid;
            grid-template-columns: minmax(0, 1fr) 72px minmax(0, 1fr);
            align-items: center;
            gap: 1.5rem;
            min-height: 140px;
            margin-bottom: 2rem;
        }
        .vertical-timeline-item:last-child { margin-bottom: 0; }
        .timeline-number {
            position: relative;
            z-index: 2;
            grid-column: 2;
            width: 58px;
            height: 58px;
            margin: 0 auto;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #020617;
            border: 1px solid rgba(63, 139, 249, 0.45);
            color: #ffffff;
            font-size: 1rem;
            font-weight: 800;
            box-shadow: 0 0 0 8px rgba(2, 6, 23, 0.92);
        }
        .timeline-content {
            position: relative;
            padding: 1.5rem;
            border-radius: 1.25rem;
            background: rgba(15, 23, 42, 0.82);
            border: 1px solid rgba(116, 105, 248, 0.25);
            box-shadow: 0 18px 40px rgba(0, 0, 0, 0.22);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
        }
        .timeline-content::before {
            content: '';
            position: absolute;
            top: 50%;
            width: 24px;
            height: 2px;
            background: linear-gradient(to right, #3F8BF9, #7469F8, #AB57F3, #E057D8);
        }
        .timeline-content.left {
            grid-column: 1;
            text-align: left;
        }
        .timeline-content.left::before {
            right: -24px;
        }
        .timeline-content.right {
            grid-column: 3;
            text-align: left;
        }
        .timeline-content.right::before {
            left: -24px;
        }
        .timeline-content h3 {
            color: #ffffff;
            font-size: 1.25rem;
            line-height: 1.25;
            font-weight: 800;
            margin: 0 0 0.75rem;
        }
        .timeline-content p {
            color: #cbd5e1;
            font-size: 0.95rem;
            line-height: 1.7;
            margin: 0;
        }
        @media (max-width: 767px) {
            .vertical-timeline::before {
                left: 29px;
            }
            .vertical-timeline-item {
                grid-template-columns: 58px minmax(0, 1fr);
                gap: 1rem;
                align-items: flex-start;
                min-height: auto;
                margin-bottom: 1.5rem;
            }
            .timeline-number {
                grid-column: 1;
                width: 50px;
                height: 50px;
                font-size: 0.9rem;
                box-shadow: 0 0 0 6px rgba(2, 6, 23, 0.92);
            }
            .timeline-content,
            .timeline-content.left,
            .timeline-content.right {
                grid-column: 2;
                text-align: left;
                padding: 1.25rem;
            }
            .timeline-content::before,
            .timeline-content.left::before,
            .timeline-content.right::before {
                left: -16px;
                right: auto;
                width: 16px;
            }
        }

        /* Best-Fit Campaigns — gradient-border pill badges */
        .best-fit-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.6rem 1.4rem;
            border-radius: 99px;
            border: 1.5px solid transparent;
            background:
                linear-gradient(rgba(15, 23, 42, 0.85), rgba(15, 23, 42, 0.85)) padding-box,
                linear-gradient(135deg, #3F8BF9, #7469F8, #AB57F3, #E057D8) border-box;
            font-size: 0.9rem;
            font-weight: 600;
            color: #e2e8f0;
            transition: all 0.3s ease;
            cursor: default;
            white-space: nowrap;
        }
        .best-fit-badge::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: linear-gradient(135deg, #3F8BF9, #AB57F3);
            flex-shrink: 0;
        }
        .best-fit-badge:hover {
            background:
                linear-gradient(rgba(63, 139, 249, 0.1), rgba(171, 87, 243, 0.1)) padding-box,
                linear-gradient(135deg, #3F8BF9, #7469F8, #AB57F3, #E057D8) border-box;
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(116, 105, 248, 0.25);
        }

        /* Compact enquiry CTA inside PPC page */
        #enquiry, #conversation { scroll-margin-top: 80px; }

        /* Mobile Responsiveness Overrides */
        @media (max-width: 767px) {
            #ppc-master section {
                padding-top: 3.5rem !important;
                padding-bottom: 3.5rem !important;
            }
        }

/* =========================================================
   PPC LIVE DECISION CONSOLE
   Scoped exclusively to .ppc-console-wrap
   ========================================================= */

.ppc-console-wrap {
  width: 620px;
  height: 540px;
  position: relative;
}

.ppc-console-replay {
  position: absolute;
  right: 0;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 8px 12px;
  border: 1px solid rgba(100,168,255,.3);
  border-radius: 999px;
  background: rgba(10,18,43,.92);
  color: #c6d0e7;
  font-size: 10px;
  cursor: pointer;
}

.ppc-console-replay:hover {
  border-color: var(--blue);
  color: white;
}

.ppc-console-replay:focus-visible {
  outline: 2px solid var(--cyan);
  outline-offset: 3px;
}

.ppc-console-replay svg {
  width: 15px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.9;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.ppc-decision-console {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 620px;
  height: 500px;
  overflow: hidden;
  border: 1px solid rgba(120,143,207,.26);
  border-radius: 24px;
  background: linear-gradient(180deg,rgba(9,17,41,.98),rgba(5,10,25,.99));
  box-shadow: 0 30px 90px rgba(0,0,0,.34), inset 0 1px rgba(255,255,255,.03);
  isolation: isolate;
}

.ppc-decision-console:before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -3;
  background-image:
    linear-gradient(rgba(104,129,190,.055) 1px,transparent 1px),
    linear-gradient(90deg,rgba(104,129,190,.055) 1px,transparent 1px);
  background-size: 28px 28px;
  mask-image: linear-gradient(to bottom,black 40%,transparent);
}

.ppc-console-aura {
  position: absolute;
  z-index: -2;
  width: 360px;
  height: 260px;
  left: 130px;
  top: 40px;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(96,73,235,.18),
    rgba(236,79,214,.07) 38%,
    transparent 72%
  );
  filter: blur(8px);
  animation: ppc-aura 3.4s ease-in-out infinite;
}

@keyframes ppc-aura {
  50% {
    transform: scale(1.1);
    opacity: .72;
  }
}

.ppc-scan-line {
  position: absolute;
  z-index: -1;
  left: 18px;
  right: 18px;
  top: 48px;
  height: 1px;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(70,224,211,.65),
    transparent
  );
  opacity: 0;
  box-shadow: 0 0 18px rgba(70,224,211,.3);
  animation: ppc-scan 7.2s ease .25s forwards;
}

@keyframes ppc-scan {
  0% { opacity: 0; transform: translateY(0); }
  8% { opacity: .5; }
  70% { opacity: .16; }
  100% { opacity: 0; transform: translateY(410px); }
}

.ppc-console-head {
  height: 39px;
  padding: 0 17px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid rgba(134,154,211,.13);
  color: #74809f;
  font-size: 7px;
  letter-spacing: .14em;
}

.ppc-console-head span {
  display: flex;
  align-items: center;
  gap: 7px;
}

.ppc-console-head i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--cyan);
  box-shadow: 0 0 11px var(--cyan);
  animation: ppc-blink 1.1s ease infinite;
}

.ppc-console-head strong {
  font-size: 6px;
  font-weight: 700;
  color: #596784;
}

@keyframes ppc-blink {
  50% { opacity: .25; }
}

.ppc-platform-strip {
  height: 43px;
  padding: 0 17px;
  display: flex;
  align-items: center;
  gap: 8px;
  border-bottom: 1px solid rgba(133,154,211,.1);
}

.ppc-platform {
  height: 23px;
  padding: 0 9px 0 5px;
  display: flex;
  align-items: center;
  gap: 6px;
  border: 1px solid rgba(121,143,199,.16);
  border-radius: 999px;
  background: rgba(8,15,35,.7);
  color: #8995b2;
  font-size: 7px;
  opacity: .62;
  animation: ppc-platform-on .45s ease forwards;
}

.ppc-platform i {
  width: 15px;
  height: 15px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: rgba(89,168,255,.12);
  color: var(--blue);
  font-size: 6px;
  font-style: normal;
  font-weight: 800;
}

.ppc-google { animation-delay: .2s; }
.ppc-meta { animation-delay: .38s; }
.ppc-pmax { animation-delay: .56s; }

.ppc-meta i {
  background: rgba(237,79,214,.12);
  color: var(--pink);
}

.ppc-pmax i {
  background: rgba(138,101,255,.14);
  color: #a98cff;
}

.ppc-platform-strip > b {
  margin-left: auto;
  color: #5e6b88;
  font-size: 6px;
  letter-spacing: .12em;
}

@keyframes ppc-platform-on {
  to {
    opacity: 1;
    border-color: rgba(102,151,230,.3);
    transform: translateY(-1px);
  }
}

.ppc-panel-kicker {
  height: 19px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #72809f;
  font-size: 6px;
  letter-spacing: .12em;
}

.ppc-panel-kicker b {
  color: #51607f;
  font-size: 5.5px;
}

.ppc-demand-panel,
.ppc-creative-lab,
.ppc-spend-console {
  position: absolute;
  border: 1px solid rgba(127,151,210,.18);
  border-radius: 14px;
  background: linear-gradient(
    145deg,
    rgba(11,20,45,.94),
    rgba(7,13,31,.9)
  );
  box-shadow: inset 0 1px rgba(255,255,255,.025);
}

.ppc-demand-panel {
  left: 17px;
  right: 17px;
  top: 94px;
  height: 129px;
  padding: 8px 13px;
}

.ppc-query-field {
  height: 35px;
  padding: 0 10px;
  display: flex;
  align-items: center;
  position: relative;
  border: 1px solid rgba(89,168,255,.2);
  border-radius: 9px;
  background: rgba(5,12,30,.8);
  overflow: hidden;
}

.ppc-query-field:after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(89,168,255,.07),
    transparent
  );
  transform: translateX(-100%);
  animation: ppc-sweep 1.2s ease .35s forwards;
}

@keyframes ppc-sweep {
  to { transform: translateX(100%); }
}

.ppc-query-field > span {
  width: 22px;
  height: 22px;
  display: grid;
  place-items: center;
  border-radius: 7px;
  background: rgba(89,168,255,.11);
  color: var(--blue);
}

.ppc-query-field svg {
  width: 13px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
}

.ppc-query-field strong {
  width: 0;
  margin-left: 9px;
  overflow: hidden;
  white-space: nowrap;
  color: #dce8ff;
  font-size: 9px;
  font-weight: 650;
  animation: ppc-type-query .8s steps(26,end) .3s forwards;
}

@keyframes ppc-type-query {
  to { width: 172px; }
}

.ppc-query-field > i {
  margin-left: auto;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--cyan);
  box-shadow: 0 0 12px var(--cyan);
  opacity: 0;
  animation: ppc-signal-on .25s ease 1.05s forwards;
}

@keyframes ppc-signal-on {
  to { opacity: 1; }
}

.ppc-auction-lane {
  height: 55px;
  margin-top: 8px;
  position: relative;
}

.ppc-auction-track {
  position: absolute;
  left: 18px;
  right: 18px;
  top: 13px;
  height: 2px;
  background: #1a2746;
}

.ppc-auction-fill {
  position: absolute;
  left: 0;
  top: 0;
  width: 0;
  height: 2px;
  background: linear-gradient(
    90deg,
    var(--blue),
    var(--purple),
    var(--pink)
  );
  box-shadow: 0 0 10px rgba(138,101,255,.5);
  animation: ppc-auction-fill 1.35s ease 1s forwards;
}

@keyframes ppc-auction-fill {
  to { width: 100%; }
}

.ppc-auction-pulse {
  position: absolute;
  left: 0;
  top: -4px;
  width: 10px;
  height: 10px;
  border: 2px solid var(--cyan);
  border-radius: 50%;
  background: #081027;
  box-shadow: 0 0 12px var(--cyan);
  opacity: 0;
  animation: ppc-auction-pulse 1.35s ease 1s forwards;
}

@keyframes ppc-auction-pulse {
  0% {
    left: 0;
    opacity: 1;
  }

  100% {
    left: calc(100% - 10px);
    opacity: 1;
  }
}

.ppc-auction-steps {
  position: absolute;
  inset: 0;
  display: flex;
  justify-content: space-between;
}

.ppc-auction-steps > span {
  width: 98px;
  position: relative;
  padding-top: 23px;
  opacity: .35;
  animation: ppc-step-on .35s ease forwards;
}

.ppc-auction-steps > span:before {
  content: "";
  position: absolute;
  left: 8px;
  top: 8px;
  width: 11px;
  height: 11px;
  border: 2px solid #3b496b;
  border-radius: 50%;
  background: #091128;
}

.ppc-auction-steps i,
.ppc-auction-steps strong,
.ppc-auction-steps em {
  font-style: normal;
}

.ppc-auction-steps i {
  margin-right: 5px;
  color: #5f6d8b;
  font-size: 6px;
}

.ppc-auction-steps strong {
  font-size: 8px;
}

.ppc-auction-steps em {
  display: block;
  margin: 2px 0 0 17px;
  color: #71809f;
  font-size: 6px;
}

.ppc-step-one {
  animation-delay: 1.2s !important;
}

.ppc-step-two {
  animation-delay: 1.65s !important;
  text-align: center;
}

.ppc-step-three {
  animation-delay: 2.05s !important;
  text-align: right;
}

.ppc-step-two:before {
  left: 43px !important;
}

.ppc-step-three:before {
  left: auto !important;
  right: 8px;
}

.ppc-step-three em {
  margin-right: 15px;
}

.ppc-auction-steps > span:after {
  content: "";
  position: absolute;
  left: 11px;
  top: 11px;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--cyan);
  opacity: 0;
}

.ppc-step-two:after {
  left: 46px !important;
}

.ppc-step-three:after {
  left: auto !important;
  right: 11px;
}

@keyframes ppc-step-on {
  to {
    opacity: 1;
    color: white;
  }
}

.ppc-step-one:after {
  animation: ppc-node-dot .2s ease 1.2s forwards;
}

.ppc-step-two:after {
  animation: ppc-node-dot .2s ease 1.65s forwards;
}

.ppc-step-three:after {
  animation: ppc-node-dot .2s ease 2.05s forwards;
}

@keyframes ppc-node-dot {
  to {
    opacity: 1;
    box-shadow: 0 0 9px var(--cyan);
  }
}

.ppc-creative-lab {
  left: 17px;
  top: 235px;
  width: 343px;
  height: 125px;
  padding: 8px 11px;
}

.ppc-creative-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 7px;
  margin-top: 2px;
}

.ppc-creative-option {
  height: 79px;
  padding: 9px;
